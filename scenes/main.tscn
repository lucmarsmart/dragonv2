[node name="HelpLabel" type="Label" parent="HUD/ControlsPanel/MarginContainer" unique_id=1074933984]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "CONTROLES DE VUELO Y TIERRA (H / F1: mostrar u ocultar):
• F / BOTÓN FUEGO: SOPLO (MANTENER); RECARGA AL SOLTAR
• L: ATERRIZAR / DESPEGAR (L CANCELA APROXIMACIÓN)
• EN TIERRA: W / S CAMINAR, SHIFT CORRER, A / D GIRAR, ESPACIO SALTAR / DESPEGAR
• EN VUELO: W / SHIFT AVANZAR (ALETEO FUERTE), S FRENAR
• A / D / FLECHAS IZQ-DER: GIRAR (Q / E: GIRO SUAVE)
• ESPACIO / R: SUBIR  •  C / CTRL: PICADA
• FLECHAS ARRIBA / ABAJO: CABECEO FINO
• G: PLANEO
• CAMARA: V O 1-4 (TRASERA / FRONTAL / DERECHA / IZQUIERDA)
• CLIC DERECHO + ARRASTRAR: ORBITAR  •  RUEDA: ZOOM
• ESC: ACTIVAR / DESACTIVAR TIMON CON MOUSE"
autowrap_mode = 3

